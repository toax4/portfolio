<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
	<head>
		<meta charset="UTF-8">
		<meta
		name="viewport" content="width=device-width, initial-scale=1.0">

		<!-- SEO Meta Tags -->
		<meta name="description" content="{% block meta_description %}Adrien Bockelandt | Développeur Full Stack basé à Toulon, spécialisé en PHP/Symfony et développement web/mobile.{% endblock %}">
		<meta name="keywords" content="Adrien Bockelandt, Développeur Full Stack, PHP, Symfony, Laravel, Flutter, Toulon, Portfolio">
		<meta name="author" content="Adrien Bockelandt">

		<link
		rel="icon" type="image/png" href="/icon.png">

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website">
		<meta property="og:title" content="{% block og_title %}Adrien Bockelandt | Développeur Full Stack{% endblock %}">
		<meta
		property="og:description" content="{% block og_description %}Développeur Full Stack basé à Toulon, spécialisé en PHP/Symfony et développement web/mobile.{% endblock %}">

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image">
		<meta property="twitter:title" content="{% block twitter_title %}Adrien Bockelandt | Développeur Full Stack{% endblock %}">
		<meta property="twitter:description" content="{% block twitter_description %}Développeur Full Stack basé à Toulon, spécialisé en PHP/Symfony et développement web/mobile.{% endblock %}">

		<title>
			{% block title %}Adrien Bockelandt | Développeur Full Stack
			{% endblock %}
		</title>

		<!-- Theme & Performance -->
		<meta name="theme-color" content="#121212">
		<link rel="preload" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@700&family=Space+Grotesk:wght@800&display=swap" as="style">

		<script type="application/ld+json" src="{{ asset('json-ld/search_engine.json') }}"></script>

		<script src="https://cdn.tailwindcss.com"></script>

		<link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="{{ asset('styles/app.css') }}">
		<script src="{{ asset('js/tailwind.js') }}"></script>
		{% block styles %}{% endblock %}
	</head>

	<body class="text-neo-black font-display antialiased selection:bg-neo-black selection:text-neo-yellow">
		<div id="cursor" class="w-6 h-6 bg-white rounded-full border-2 border-black hidden lg:block"></div>

		<div class="fixed top-0 left-0 h-2 bg-neo-green z-[60] border-b-2 border-black" id="progressBar" style="width: 0%"></div>

		{% block body %}{% endblock %}

		<script src="{{ asset('js/app.js') }}"></script>
		{% block scripts %}{% endblock %}
	</body>
</html>
