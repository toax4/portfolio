<div class="reveal relative pl-8 md:pl-16">
	<div class="absolute -left-[14px] top-2 w-6 h-6 bg-company-{{ experience.company|slugify }} border-4 border-black"></div>
	<div class="bg-white border-4 border-black p-6 shadow-hard hover:shadow-hard-xl transition-all">
		<div class="flex flex-col md:flex-row justify-between items-start md:items-center border-b-2 border-dashed border-gray-300 pb-4 mb-4">
			<h3 class="text-3xl font-black uppercase">{{ experience.title }}</h3>
			<span class="font-mono font-bold bg-neo-black text-white px-2 py-1">
				{{ experience.startDate|format_datetime(pattern: "Y") }}
				-
				{% if experience.endDate is null %}PRÉSENT
				{% else %}
					{{ experience.endDate|format_datetime(pattern: "Y") }}
				{% endif %}
			</span>
		</div>
		<p class="font-mono text-xl mb-2 text-company-{{ experience.company|slugify }} font-bold">@
			{{ experience.company }}</p>
		{# <ul class="list-disc list-inside font-mono text-gray-700 space-y-1">
					<li>Développement et maintenance d'applications web avec PHP / Symfony</li>
					<li>Conception d'API REST consommées par des clients web et mobile</li>
					<li>Collaboration avec l'équipe produit pour prioriser les fonctionnalités</li>
				</ul> #}
		<a href="{{ path('experience_show', {'pageId': experience.id}) }}" class="inline-flex items-center gap-1 mt-4 font-mono font-bold text-sm border-b-2 border-black hover:bg-neo-yellow cursor-hover">
			VOIR LE DÉTAIL
			<i class="ri-arrow-right-up-line"></i>
		</a>
	</div>
</div>
