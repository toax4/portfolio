{% extends 'layouts/pdf.html.twig' %}

{% block title %}CV — Adrien Bockelandt | Adrien Bockelandt
{% endblock %}
{% block meta_description %}CV d'Adrien Bockelandt, développeur Full Stack — PHP/Symfony/Laravel, Flutter, C#.
{% endblock %}

{% block content %}
    {# Données brutes / exemple — à remplacer par les données Notion (technologies, experiences, formations, projects). #}
    {% set experiences = [
			{
				title: 'Développeur Fullstack',
				company: 'Galaxy Hotels',
				period: '2026 – présent',
				description: "Développement et maintenance d'applications web fullstack pour le secteur hôtelier, en garantissant la fiabilité et la performance des solutions déployées.",
				technologies: ['PHP', 'HTML', 'CSS', 'JS', 'MariaDB'],
				accent: 'text-neo-orange',
			},
			{
				title: 'Développeur Fullstack Web / Mobile',
				company: 'COS Méditerranée',
				period: '2019 – 2024',
				description: "Association proposant prestations et avantages sociaux aux salariés d'entreprises clientes. Conception et développement de plusieurs outils métier : application mobile Bénéficiaire, SaaS interne de gestion des prestations financières (inventaire, planning du personnel) et plateforme d'espace administratif pour les entreprises clientes (V1 puis refonte complète). Web : PHP/MySQL, API RESTful. Mobile (Flutter) : demandes de prestations, carte des commerçants partenaires, porte-monnaie virtuel QR Code, scan inventaire. Formation et mentorat d'alternants, support technique.",
				technologies: ['PHP', 'HTML', 'CSS', 'JS', 'Bootstrap', 'MySQL', 'Flutter', 'Dart'],
				accent: 'text-neo-purple',
			},
			{
				title: 'Stagiaire Technicien Maintenance Informatique',
                subtitle: "22 semaines de stages",
				company: 'Institut de Rééducation Fonctionnelle Pomponiana Olbia (IRFPO)',
				period: '2014 – 2017',
				description: "Maintenance et dépannage du parc informatique en environnement institutionnel.",
				technologies: [],
				accent: 'text-neo-blue',
			},
		] %}

    {% set projects = [
			{
				title: 'Aegis',
				tag: 'Projet perso',
				subtitle: 'Application communautaire pour Warhammer: Age of Sigmar',
				description: "Stack Symfony + API Platform, Mercure, EasyAdmin, Flutter, PostgreSQL. Builders d'armées, mode partie en direct (phases, chrono, score), ladder QR code, snapshots immuables de listes, statistiques (winrate, présence des unités), Q&A communautaire.",
				technologies: ['Symfony', 'PHP', 'PostgreSQL', 'Flutter'],
			},
		] %}

    {# {% set tech_stack = [
			{name: 'PHP', color: '#777BB4'}, {name: 'Symfony', color: '#000000'}, {name: 'Laravel', color: '#FF2D20'},
			{name: 'Flutter', color: '#02569B'}, {name: 'Dart', color: '#0175C2'}, {name: 'C#', color: '#512BD4'},
			{name: 'MySQL'}, {name: 'PostgreSQL'}, {name: 'MongoDB'},
			{name: 'HTML'}, {name: 'CSS'}, {name: 'JS', dark: true}, {name: 'TS'},
			{name: 'Bootstrap'}, {name: 'Sass'}, {name: 'Vue.js'},
			{name: 'Docker'}, {name: 'Linux', dark: true}, {name: 'Regex'},
		] %} #}

    {% set formations = [
			{period: '2017 – 2019', title: 'BTS Services Informatiques aux Organisations (SIO)', subtitle: 'Option Solutions Logicielles et Applications Métiers (SLAM)'},
			{period: '2014 – 2017', title: 'Baccalauréat Professionnel', subtitle: 'Système Électronique et Numérique (SEN)'},
		] %}

    <hr class="border-2 border-black my-4">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <main class="md:col-span-7">
            <section class="mb-6">
                <div class="space-y-3">
                    {% for experience in experiences %}
                        <div class="border-2 border-black bg-white p-4 shadow-hard-sm my-3">
                            <div class="flex flex-row items-start justify-between gap-2 mb-1">
                                <h3 class="font-black text-sm uppercase leading-snug flex-grow">
                                    {{ experience.title }}

                                </h3>

                                <span class="bg-neo-black text-white font-mono text-xs font-bold px-2 py-0.5 whitespace-nowrap flex-none">
                                    {{ experience.period }}
                                </span>
                            </div>
                            {% if experience.subtitle is defined %}
                                <h6 class="font-mono text-[10px] text-gray-600">{{ experience.subtitle }}</h6>
                            {% endif %}
                            <p class="font-mono text-xs italic font-bold {{ experience.accent }} mb-2">
                                @
                                {{ experience.company }}
                            </p>
                            <p class="text-xs text-gray-700 leading-relaxed mb-3">
                                {{ experience.description }}
                            </p>
                            {% if experience.technologies %}
                                <div class="flex flex-wrap gap-1">
                                    {% for tech in experience.technologies %}
                                        <span class="border border-black font-mono text-[10px] font-bold px-1.5 py-0.5">{{ tech }}</span>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </section>
        </main>

        <aside class="md:col-span-5 space-y-4">
            <div class="border-2 border-black bg-white p-4 shadow-hard-sm">
                <h2 class="font-black text-base uppercase mb-2">Qui suis-je ?</h2>
                <p class="text-xs text-gray-700 leading-relaxed mb-3">
                    Développeur spécialisé en web fullstack et applications mobiles via Flutter, avec une expérience en gestion de projet et mentorat d'alternants. Passionné par la création de solutions technologiques innovantes.
                </p>
            </div>

            <div class="border-2 border-black bg-white p-4 shadow-hard-sm">
                <div class="flex flex-wrap gap-1.5">
                    {% for tech in technologies %}
                        <span class="inline-block border-2 border-black px-2 py-1 font-mono text-[10px] {% if tech.color is defined %}text-white{% endif %} font-bold" {% if tech.color is defined %} style="background-color: {% if tech.color != '' %}{{ tech.color }}{% else %}#333{% endif %};"{% endif %}>
                            {{ tech.title }}
                        </span>
                    {% endfor %}
                </div>
            </div>

            <div class="border-2 border-black bg-white p-4 shadow-hard-sm">
                <h2 class="font-black text-base uppercase mb-2">Études</h2>
                <div class="space-y-2">
                    {% for formation in formations %}
                        <div class="border-l-4 border-neo-blue pl-3">
                            <p class="font-mono text-xs font-bold text-neo-blue">{{ formation.period }}</p>
                            <p class="font-black text-xs uppercase leading-snug">{{ formation.title }}</p>
                            <p class="font-mono text-[10px] text-gray-600">{{ formation.subtitle }}</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </aside>
    </div>

    <div class="border-2 border-black bg-white p-4 shadow-hard-sm mt-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <h2 class="font-black text-base uppercase mb-2">Passions</h2>
                <div class="flex flex-wrap gap-1.5">
                    <span class="border border-black font-mono text-[10px] font-bold px-1.5 py-0.5">💻 Dev</span>
                    <span class="border border-black font-mono text-[10px] font-bold px-1.5 py-0.5">⚔️ Warhammer</span>
                    <span class="border border-black font-mono text-[10px] font-bold px-1.5 py-0.5">🏉 Rugby</span>
                    <span class="border border-black font-mono text-[10px] font-bold px-1.5 py-0.5">🐷 Cuisine</span>
                </div>
            </div>

            <div>
                <h2 class="font-black text-base uppercase mb-2">Langues</h2>
                <div class="flex flex-wrap gap-1.5">
                    <span class="border border-black font-mono text-[10px] font-bold px-1.5 py-0.5">Français — Natif</span>
                    <span class="border border-black font-mono text-[10px] font-bold px-1.5 py-0.5">Anglais — Technique</span>
                </div>
            </div>

            <div>
                <h2 class="font-black text-base uppercase mb-2">Permis</h2>
                <div class="flex flex-wrap gap-1.5">
                    <span class="border border-black font-mono text-[10px] font-bold px-1.5 py-0.5">Permis A</span>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3 -mx-[10mm] bg-neo-blue border-t-4 border-b-4 border-black py-2 overflow-hidden absolute bottom-0 left-0 right-0">
        <p class="font-mono font-bold text-white text-xs whitespace-nowrap text-center tracking-wide">
            /// DÉVELOPPEMENT FULL STACK /// PHP • SYMFONY • LARAVEL /// FLUTTER /// TOULON ///
        </p>
    </div>
{% endblock %}
